<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Mac App Store entitlements. These are NOT the same file as
    Entitlements.plist: a Store build must additionally carry the
    application-identifier and team-identifier that the embedded
    provisioning profile grants. Sign with this file; ship the other one
    only for local/Developer ID builds.

    Every key here must be granted by the Mac App Store provisioning
    profile for design.floid.app, or codesign succeeds and the App Store
    rejects the upload with ITMS-90287 "Invalid Code Signing Entitlements".

    No network entitlement on purpose — FLOID is fully offline. Adding one
    later means updating the App Privacy answers too.
  -->
  <key>com.apple.application-identifier</key>
  <string>LPJ28CF2F5.design.floid.app</string>
  <key>com.apple.developer.team-identifier</key>
  <string>LPJ28CF2F5</string>

  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
</dict>
</plist>
