<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Mac App Store entitlements. These are NOT the same file as
    Entitlements.plist: a Store build must additionally carry the
    application-identifier and team-identifier that the embedded
    provisioning profile grants. Sign with this file; ship the other one
    only for local/Developer ID builds.

    Every key here must be granted by the Mac App Store provisioning
    profile for design.floid.app, or codesign succeeds and the App Store
    rejects the upload with ITMS-90287 "Invalid Code Signing Entitlements".
  -->
  <key>com.apple.application-identifier</key>
  <string>LPJ28CF2F5.design.floid.app</string>
  <key>com.apple.developer.team-identifier</key>
  <string>LPJ28CF2F5</string>

  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>

  <!--
    Required by WKWebView, not by FLOID. WebKit loads every resource
    through its Network process — including Tauri's local custom scheme.
    Under the sandbox without this key that process never starts, the
    WebContent process exits 1 on each of five respawns, and the window
    renders nothing at all. It is a capability, not a behaviour: the app
    still makes no requests, the CSP still pins connect-src to ipc: and
    http://ipc.localhost, and no analytics mounts on desktop. Removing it
    to "stay offline" produces a blank app, not an offline one.
  -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
